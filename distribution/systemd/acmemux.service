[Unit]
Description=AcmeMux certificate operations service
Documentation=https://github.com/sgurden-certleap/AcmeMux
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=acmemux
Group=acmemux
WorkingDirectory=/var/lib/acmemux
EnvironmentFile=/etc/acmemux/acmemux.env
ExecStart=/usr/local/bin/acmemux serve
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=100s
KillMode=mixed
UMask=0077

StateDirectory=acmemux
StateDirectoryMode=0700
RuntimeDirectory=acmemux
RuntimeDirectoryMode=0700

AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=full
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=acmemux

[Install]
WantedBy=multi-user.target
